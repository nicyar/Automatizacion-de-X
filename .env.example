# Copiá este archivo a .env y completá los valores. .env está en .gitignore: no lo subas.

# Cuenta de X que usa twscrape para leer y publicar
USERNAME=
EMAIL=
PASSWORD=
COOKIES=

# Bot de Telegram (token de @BotFather) y chat al que responde
TELEGRAM_BOT_TOKEN=
CHAT_ID=

# Reescrituras con IA (Google AI Studio)
GEMINI_API_KEY=

# Opcional: "mock" simula la publicación sin gastar tweets reales (default: real)
# MODO_PUBLICACION=mock
